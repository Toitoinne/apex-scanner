# Couche IA (facultative). Sans clé, seul le moteur local fonctionne.
# Créez une clé sur https://platform.claude.com puis copiez ce fichier en .env.local
ANTHROPIC_API_KEY=

# Modèle utilisé pour la correction contextuelle (défaut : claude-opus-5-5).
# claude-haiku-5-5 coûte environ 40 fois moins cher, à évaluer sur vos textes.
# AUTOCORRECT_MODEL=claude-opus-5-5
