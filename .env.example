# Copier en .env et remplir. Ne jamais committer .env.

# Helius (RPC + websocket logsSubscribe) — https://dashboard.helius.dev
HELIUS_API_KEY=
# Optionnel : URLs complètes (sinon construites depuis HELIUS_API_KEY)
HELIUS_RPC_URL=
HELIUS_WS_URL=

# Flux pump.fun complet : websocket(s) GRATUIT(S), séparés par des virgules (redondance).
# Défaut : RPC public Solana. Tu peux ajouter le websocket d'une offre gratuite d'un autre fournisseur.
SOLANA_WS_URLS=wss://api.mainnet-beta.solana.com
# Redondance recommandée : ajoute, après une virgule, le websocket d'une 2e offre gratuite
# (ex. Chainstack Developer, compte gratuit). Vérifie d'abord dans ses conditions comment les
# notifications websocket sont décomptées. Exemple :
# SOLANA_WS_URLS=wss://api.mainnet-beta.solana.com,wss://solana-mainnet.core.chainstack.com/TA_CLE

# PumpPortal (optionnel ; requis seulement pour les trades PumpPortal payants)
PUMPPORTAL_API_KEY=

# Dune (backfill) — https://dune.com/settings/api
DUNE_API_KEY=

# Anthropic (amélioration par Claude, section 11) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Telegram : créer un bot avec @BotFather, récupérer le chat_id avec @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard : jeton d'accès (http://localhost:8080/?token=...)
DASHBOARD_TOKEN=

POSTGRES_PASSWORD=change-me
# Hors Docker uniquement :
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql://apex:change-me@localhost:5432/apex
# DATA_DIR=./data
